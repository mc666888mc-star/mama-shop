.pg { padding: 0 32rpx; }
.ph { color: #A1A1A6; }
.addr { display: flex; align-items: center; padding: 32rpx 28rpx; margin-bottom: 20rpx; border-radius: 40rpx; background: #fff; transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s; }
.addr-ico { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(0, 113, 227, 0.10); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.addr-pin { width: 40rpx; height: 40rpx; }
.addr-main { flex: 1; min-width: 0; margin: 0 16rpx 0 24rpx; }
.addr-who { font-size: 32rpx; font-weight: 600; }
.addr-phone { margin-left: 20rpx; font-size: 28rpx; font-weight: 400; color: #6E6E73; }
.addr-where { margin-top: 6rpx; font-size: 27rpx; line-height: 1.5; color: #6E6E73; }
.chev { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.goods { padding: 12rpx 28rpx; margin-bottom: 20rpx; }
.g { display: flex; align-items: center; padding: 20rpx 0; }
.g + .g { border-top: 1rpx solid rgba(60, 60, 67, 0.12); }
.g-img { width: 136rpx; height: 136rpx; border-radius: 24rpx; overflow: hidden; flex-shrink: 0; }
.g-main { flex: 1; min-width: 0; margin-left: 24rpx; height: 136rpx; display: flex; flex-direction: column; justify-content: space-between; }
.g-name { font-size: 28rpx; line-height: 40rpx; }
.g-foot { display: flex; align-items: baseline; justify-content: space-between; }
.g-price { font-size: 32rpx; font-weight: 700; }
.g-qty { font-size: 28rpx; color: #6E6E73; }

.remark { padding: 0 28rpx; margin-bottom: 20rpx; }
.remark-in { height: 104rpx; font-size: 29rpx; }
.note { padding: 8rpx 16rpx; font-size: 26rpx; line-height: 1.6; color: #6E6E73; }
.safe { height: calc(220rpx + env(safe-area-inset-bottom)); }

.bar { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 16rpx); z-index: 50; height: 112rpx; padding: 0 12rpx 0 36rpx; border-radius: 56rpx; display: flex; align-items: center; }
.bar-sum { flex: 1; min-width: 0; }
.bar-l { font-size: 24rpx; color: #6E6E73; }
.bar-money { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.bar-go { height: 88rpx; padding: 0 56rpx; border-radius: 44rpx; font-size: 30rpx; }

/* 地址弹层 */
.imp { height: 88rpx; border-radius: 24rpx; background: rgba(0, 113, 227, 0.10); color: #0071E3; font-size: 29rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; transition: transform 0.2s, opacity 0.2s; }
.fld { display: flex; align-items: flex-start; padding: 28rpx 4rpx; border-bottom: 1rpx solid rgba(60, 60, 67, 0.14); }
.fld-last { border-bottom: none; }
.fld-l { width: 140rpx; padding-top: 4rpx; font-size: 30rpx; color: #6E6E73; flex-shrink: 0; }
.fld-in { flex: 1; height: 44rpx; font-size: 32rpx; }
.fld-ta { flex: 1; min-height: 88rpx; font-size: 32rpx; line-height: 1.45; }
.save { margin-top: 24rpx; }
