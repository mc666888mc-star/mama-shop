<!-- pages/checkout/checkout.wxml -->
<view class="card">
  <view class="row"><text>商品</text><text>{{product.name}} × {{qty}}</text></view>
  <view class="row"><text>收货人</text><input placeholder="姓名" bindinput="onName" /></view>
  <view class="row"><text>电话</text><input placeholder="手机号" type="number" bindinput="onPhone" /></view>
  <view class="row"><text>地址</text><input placeholder="详细地址" bindinput="onDetail" /></view>
  <view class="row"><text>备注</text><input placeholder="选填" bindinput="onNote" /></view>
</view>
<view class="card">
  <view class="row total"><text>合计</text><text class="price">¥{{totalText}}</text></view>
</view>
<view class="buy-bar">
  <button class="btn-big" type="primary" bindtap="submitOrder">提交订单</button>
</view>
