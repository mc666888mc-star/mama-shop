/* pages/checkout/checkout.wxss */
.row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 34rpx; }
.row input { text-align: right; flex: 1; margin-left: 20rpx; }
.total { font-size: 40rpx; border-bottom: none; }
.buy-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
