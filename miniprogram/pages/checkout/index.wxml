<nav-bar title="确认订单" back="{{true}}" />

<view class="pg">
  <view class="addr" hover-class="press" hover-stay-time="40" bindtap="openSheet">
    <view class="addr-ico"><image class="addr-pin" src="/images/icons/pin.svg" /></view>
    <view class="addr-main">
      <block wx:if="{{address}}">
        <view class="addr-who">{{address.name}}<text class="addr-phone">{{address.phone}}</text></view>
        <view class="addr-where">{{address.detail}}</view>
      </block>
      <block wx:else>
        <view class="addr-who">添加收货地址</view>
        <view class="addr-where">填一次，下次自动带出</view>
      </block>
    </view>
    <image class="chev" src="/images/icons/chevron-right.svg" />
  </view>

  <view class="card goods">
    <view wx:for="{{items}}" wx:key="productId" class="g">
      <view class="g-img"><thumb src="{{item.image}}" emoji="{{item.emoji}}" tone="{{item.tone}}" seed="{{item.productId}}" size="56rpx" /></view>
      <view class="g-main">
        <view class="g-name ellipsis2">{{item.name}}</view>
        <view class="g-foot"><view class="g-price">¥{{item.priceText}}</view><view class="g-qty">× {{item.qty}}</view></view>
      </view>
    </view>
  </view>

  <view class="card remark">
    <input class="remark-in" value="{{remark}}" maxlength="60" placeholder="给妈妈留言（选填）" placeholder-class="ph" bindinput="onRemark" />
  </view>

  <view class="note">
    <block wx:if="{{payMode === 'wxpay'}}">提交订单后，使用微信支付付款。</block>
    <block wx:else>提交订单后，按提示用微信转账给妈妈，妈妈确认收到后就会安排发货。</block>
  </view>

  <view class="safe"></view>
</view>

<view class="bar glass">
  <view class="bar-sum">
    <view class="bar-l">共 {{count}} 件，合计</view>
    <view class="bar-money">¥{{totalText}}</view>
  </view>
  <view class="btn btn-primary bar-go {{submitting ? 'disabled' : ''}}" hover-class="press" bindtap="submit">提交订单</view>
</view>

<sheet show="{{sheet}}" title="收货地址" bind:close="closeSheet">
  <view class="imp" hover-class="press" bindtap="importWx">从微信导入地址</view>
  <view class="fld"><view class="fld-l">收货人</view><input class="fld-in" value="{{form.name}}" placeholder="姓名" placeholder-class="ph" data-k="name" bindinput="onField" cursor-spacing="40" /></view>
  <view class="fld"><view class="fld-l">手机号</view><input class="fld-in" type="number" maxlength="11" value="{{form.phone}}" placeholder="11 位手机号" placeholder-class="ph" data-k="phone" bindinput="onField" cursor-spacing="40" /></view>
  <view class="fld fld-last"><view class="fld-l">地址</view><textarea class="fld-ta" auto-height="{{true}}" maxlength="100" value="{{form.detail}}" placeholder="小区、楼栋、门牌号" placeholder-class="ph" data-k="detail" bindinput="onField" cursor-spacing="40" /></view>
  <view class="btn btn-primary save" hover-class="press" bindtap="saveAddress">保存地址</view>
</sheet>
