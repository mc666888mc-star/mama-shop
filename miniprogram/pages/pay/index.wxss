.pg { padding: 0 32rpx; }
.top { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 48rpx; }
.ok { width: 128rpx; height: 128rpx; border-radius: 50%; background: linear-gradient(145deg, #3DA0FF, #0071E3); display: flex; align-items: center; justify-content: center; box-shadow: 0 20rpx 48rpx rgba(0, 113, 227, 0.32), inset 0 2rpx 0 rgba(255, 255, 255, 0.5); }
.ok-ico { width: 60rpx; height: 60rpx; }
.top-t { margin-top: 32rpx; font-size: 36rpx; font-weight: 600; }
.amount { margin-top: 8rpx; font-size: 88rpx; font-weight: 700; letter-spacing: -2rpx; }
.yen { font-size: 44rpx; font-weight: 600; margin-right: 6rpx; }
.no { margin-top: 12rpx; height: 64rpx; padding: 0 28rpx; line-height: 64rpx; border-radius: 32rpx; background: rgba(118, 118, 128, 0.12); font-size: 27rpx; color: #3A3A3C; transition: transform 0.2s, opacity 0.2s; }
.no-copy { margin-left: 16rpx; color: #0071E3; font-weight: 600; }
.steps { padding: 20rpx 32rpx; }
.s { display: flex; align-items: flex-start; padding: 24rpx 0; }
.s + .s { border-top: 1rpx solid rgba(60, 60, 67, 0.12); }
.s-n { width: 48rpx; height: 48rpx; margin-right: 24rpx; border-radius: 50%; background: rgba(0, 113, 227, 0.10); color: #0071E3; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.s-t { flex: 1; font-size: 30rpx; line-height: 1.55; color: #1D1D1F; padding-top: 4rpx; }
.s-b { font-weight: 700; }
.paid { padding: 24rpx 0; font-size: 30rpx; line-height: 1.55; color: #3A3A3C; }
.help { margin-top: 28rpx; text-align: center; font-size: 28rpx; color: #0071E3; font-weight: 500; transition: opacity 0.2s; }
.safe { height: calc(200rpx + env(safe-area-inset-bottom)); }
.bar { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(env(safe-area-inset-bottom) + 24rpx); display: flex; z-index: 50; }
.full { flex: 1; }
.half { flex: 1; }
.half + .half { margin-left: 20rpx; }
