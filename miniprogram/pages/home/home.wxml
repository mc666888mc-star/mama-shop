<!-- pages/home/home.wxml -->
<view class="search-bar">
  <input placeholder="搜洗碗布、洗洁精" bindinput="onSearchInput" />
</view>
<view class="product-list">
  <view class="product-card" wx:for="{{products}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
    <image class="thumb" src="{{item.images[0] || '/images/placeholder.png'}}" mode="aspectFill"></image>
    <view class="name">{{item.name}}</view>
    <view class="price">¥{{item.priceText}}</view>
  </view>
</view>
<view wx:if="{{products.length === 0}}" class="empty">还没有商品，妈妈正在上架中…</view>
