<!-- pages/orders/orders.wxml -->
<view class="tabs">
  <view class="tab {{tab===0?'active':''}}" bindtap="switchTab" data-i="0">待付款</view>
  <view class="tab {{tab===1?'active':''}}" bindtap="switchTab" data-i="1">待发货</view>
  <view class="tab {{tab===2?'active':''}}" bindtap="switchTab" data-i="2">已发货</view>
  <view class="tab {{tab===3?'active':''}}" bindtap="switchTab" data-i="3">已完成</view>
</view>
<view class="card" wx:for="{{orders}}" wx:key="_id">
  <view class="row"><text>订单号</text><text class="mono">{{item._id}}</text></view>
  <view class="row"><text>商品</text><text>{{item.summary}}</text></view>
  <view class="row"><text>合计</text><text class="price">¥{{item.totalText}}</text></view>
  <view class="row" wx:if="{{item.expressNo}}"><text>快递单号</text><text>{{item.expressNo}}</text></view>
</view>
<view wx:if="{{orders.length === 0}}" class="empty">还没有订单</view>
