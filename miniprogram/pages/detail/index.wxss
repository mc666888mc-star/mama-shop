page { background: #fff; }
.sk-img { width: 100%; height: 750rpx; border-radius: 0; }
.gallery { position: relative; width: 100%; height: 780rpx; }
.gal { width: 100%; height: 780rpx; }
.gal-img { width: 100%; height: 780rpx; display: block; }
.dots { position: absolute; left: 0; right: 0; bottom: 84rpx; display: flex; justify-content: center; }
.dot { width: 12rpx; height: 12rpx; margin: 0 6rpx; border-radius: 6rpx; background: rgba(255, 255, 255, 0.6); transition: width 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.25s; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2); }
.dot-on { width: 32rpx; background: #fff; }

.panel { position: relative; margin-top: -56rpx; padding: 48rpx 40rpx 0; border-radius: 56rpx 56rpx 0 0; background: #fff; min-height: 640rpx; }
.p-name { font-size: 46rpx; font-weight: 700; letter-spacing: -0.5rpx; line-height: 1.3; color: #1D1D1F; }
.p-price { margin-top: 16rpx; font-size: 60rpx; font-weight: 700; color: #1D1D1F; }
.yen { font-size: 34rpx; font-weight: 600; margin-right: 4rpx; }
.p-note { margin-top: 16rpx; font-size: 28rpx; color: #6E6E73; }
.p-warn { color: #FF9500; font-weight: 600; }
.p-desc { margin-top: 32rpx; font-size: 30rpx; line-height: 1.7; color: #3A3A3C; }
.p-qty { margin-top: 48rpx; padding-top: 32rpx; border-top: 1rpx solid rgba(60, 60, 67, 0.14); display: flex; align-items: center; justify-content: space-between; }
.p-qty-l { font-size: 32rpx; font-weight: 600; }
.safe { height: calc(220rpx + env(safe-area-inset-bottom)); }

.bar { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 16rpx); z-index: 50; height: 112rpx; padding: 0 12rpx; border-radius: 56rpx; display: flex; align-items: center; }
.bar-cart { position: relative; width: 88rpx; height: 88rpx; margin-right: 12rpx; border-radius: 50%; background: rgba(118, 118, 128, 0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.2s, opacity 0.2s; }
.bar-cart-ico { width: 44rpx; height: 44rpx; }
.bar-badge { position: absolute; top: -2rpx; right: -4rpx; min-width: 34rpx; height: 34rpx; padding: 0 9rpx; border-radius: 17rpx; background: #FF3B30; color: #fff; font-size: 21rpx; font-weight: 600; line-height: 34rpx; text-align: center; }
.bar-btn { flex: 1; height: 88rpx; padding: 0; border-radius: 44rpx; font-size: 30rpx; }
.bar-btn + .bar-btn { margin-left: 12rpx; }
