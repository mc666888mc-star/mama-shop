/* 妈妈后台：同一套苹果风，但字更大、对比更高、一律实底不用玻璃 */
.pg { padding: 24rpx 28rpx 0; }
.ph { color: #8E8E93; }
.stats { display: flex; margin-bottom: 24rpx; }
.stat { flex: 1; padding: 32rpx 32rpx 28rpx; border-radius: 40rpx; background: #fff; }
.stat + .stat { margin-left: 20rpx; }
.stat-n { font-size: 80rpx; font-weight: 700; line-height: 1.1; letter-spacing: -2rpx; color: #1D1D1F; }
.stat-y { font-size: 42rpx; font-weight: 600; margin-right: 4rpx; }
.stat-l { margin-top: 8rpx; font-size: 32rpx; color: #3A3A3C; }

.o { margin-bottom: 24rpx; padding: 36rpx 32rpx 32rpx; border-radius: 40rpx; background: #fff; }
.o-done { opacity: 0.7; }
.o-top { display: flex; align-items: center; justify-content: space-between; }
.o-no { font-size: 40rpx; font-weight: 700; }
.o-st { height: 56rpx; padding: 0 24rpx; line-height: 56rpx; border-radius: 28rpx; font-size: 30rpx; font-weight: 700; }
.s0 { background: rgba(255, 149, 0, 0.14); color: #C93400; }
.s1 { background: rgba(0, 113, 227, 0.12); color: #0058B0; }
.s2 { background: rgba(0, 113, 227, 0.12); color: #0058B0; }
.s3 { background: rgba(60, 60, 67, 0.10); color: #3A3A3C; }
.o-time { margin: 8rpx 0 20rpx; font-size: 28rpx; color: #6E6E73; }
.o-items { padding: 20rpx 0; border-top: 1rpx solid rgba(60, 60, 67, 0.14); border-bottom: 1rpx solid rgba(60, 60, 67, 0.14); }
.o-line { display: flex; align-items: flex-start; justify-content: space-between; padding: 8rpx 0; }
.o-nm { flex: 1; min-width: 0; font-size: 36rpx; line-height: 1.4; }
.o-q { margin-left: 20rpx; font-size: 36rpx; font-weight: 700; flex-shrink: 0; }
.o-sum { margin-top: 20rpx; font-size: 32rpx; color: #3A3A3C; }
.o-total { margin-left: 8rpx; font-size: 46rpx; font-weight: 700; color: #1D1D1F; }
.o-addr { display: flex; align-items: center; margin-top: 24rpx; padding: 24rpx; border-radius: 28rpx; background: #F5F5F7; }
.o-addr-main { flex: 1; min-width: 0; }
.o-who { font-size: 34rpx; font-weight: 600; }
.o-where { margin-top: 6rpx; font-size: 32rpx; line-height: 1.5; color: #3A3A3C; }
.o-call { height: 76rpx; padding: 0 28rpx; margin-left: 16rpx; line-height: 76rpx; border-radius: 38rpx; background: rgba(0, 113, 227, 0.12); color: #0058B0; font-size: 30rpx; font-weight: 700; flex-shrink: 0; transition: transform 0.2s, opacity 0.2s; }
.o-remark { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: rgba(255, 149, 0, 0.12); font-size: 32rpx; line-height: 1.5; color: #7A3E00; }
.o-exp { margin-top: 20rpx; font-size: 32rpx; color: #3A3A3C; }

/* 大按钮：每个订单只有一个，写的就是下一步要做的事 */
.act { margin-top: 28rpx; height: 120rpx; border-radius: 60rpx; background: #0071E3; color: #fff; font-size: 44rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 28rpx rgba(0, 113, 227, 0.30); transition: transform 0.2s, opacity 0.2s; }
.act-press { transform: scale(0.97); opacity: 0.88; }
.done-tip { margin-top: 24rpx; text-align: center; font-size: 32rpx; color: #6E6E73; }
.safe { height: calc(80rpx + env(safe-area-inset-bottom)); }

.sh-l { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.sh-l2 { margin-top: 36rpx; }
.sh-in { height: 112rpx; padding: 0 28rpx; border-radius: 28rpx; background: #F2F2F7; font-size: 40rpx; }
.chips { display: flex; }
.chip { flex: 1; height: 112rpx; line-height: 112rpx; text-align: center; border-radius: 28rpx; background: #F2F2F7; font-size: 38rpx; font-weight: 600; border: 4rpx solid transparent; transition: transform 0.2s, background 0.2s; }
.chip + .chip { margin-left: 20rpx; }
.chip-on { background: rgba(0, 113, 227, 0.10); border-color: #0071E3; color: #0058B0; }
.sh-go { margin-top: 40rpx; }
