.pg { padding: 24rpx 28rpx 0; }
.ph { color: #8E8E93; }
.tips { margin-bottom: 20rpx; border-radius: 40rpx; background: rgba(0, 113, 227, 0.08); overflow: hidden; }
.tips-h { display: flex; align-items: center; justify-content: space-between; padding: 32rpx; transition: opacity 0.2s, transform 0.2s; }
.tips-t { font-size: 36rpx; font-weight: 700; color: #0058B0; }
.tips-a { font-size: 32rpx; font-weight: 700; color: #0058B0; }
.tips-b { padding: 0 32rpx 24rpx; }
.tip { position: relative; padding: 14rpx 0 14rpx 32rpx; font-size: 32rpx; line-height: 1.55; color: #1D1D1F; }
.tip::before { content: ''; position: absolute; left: 4rpx; top: 30rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #0071E3; }

.blk { margin-bottom: 20rpx; padding: 28rpx 32rpx; border-radius: 40rpx; background: #fff; }
.lab { margin-bottom: 16rpx; font-size: 34rpx; font-weight: 700; }
.lab-s { margin-left: 8rpx; font-size: 28rpx; font-weight: 400; color: #6E6E73; }
.in { height: 104rpx; padding: 0 28rpx; border-radius: 28rpx; background: #F2F2F7; font-size: 42rpx; }
.ta { width: 100%; min-height: 180rpx; padding: 24rpx 28rpx; border-radius: 28rpx; background: #F2F2F7; font-size: 36rpx; line-height: 1.5; }
.row2 { display: flex; }
.half { flex: 1; min-width: 0; }
.half + .half { margin-left: 20rpx; }

.imgs { display: flex; flex-wrap: wrap; }
.im { position: relative; width: 200rpx; height: 200rpx; margin: 0 16rpx 16rpx 0; border-radius: 28rpx; overflow: hidden; background: #F2F2F7; transition: transform 0.2s, opacity 0.2s; }
.im:nth-child(3n) { margin-right: 0; }
.im-i { width: 100%; height: 100%; display: block; }
.im-cover { position: absolute; left: 0; right: 0; bottom: 0; height: 44rpx; line-height: 44rpx; text-align: center; background: rgba(0, 0, 0, 0.5); color: #fff; font-size: 24rpx; font-weight: 600; }
.im-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 3rpx dashed #C7C7CC; background: #fff; }
.im-plus { width: 56rpx; height: 56rpx; }
.im-add-t { margin-top: 8rpx; font-size: 28rpx; color: #6E6E73; font-weight: 600; }

.sale { min-height: 104rpx; padding: 24rpx 28rpx; border-radius: 28rpx; background: rgba(60, 60, 67, 0.10); color: #3A3A3C; font-size: 32rpx; font-weight: 700; line-height: 1.45; text-align: center; transition: transform 0.2s, opacity 0.2s; }
.sale-on { background: rgba(52, 199, 89, 0.16); color: #176B31; }

.safe { height: calc(220rpx + env(safe-area-inset-bottom)); }
.bar { position: fixed; left: 28rpx; right: 28rpx; bottom: calc(env(safe-area-inset-bottom) + 24rpx); z-index: 50; }
.save { height: 120rpx; border-radius: 60rpx; background: #0071E3; color: #fff; font-size: 44rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 28rpx rgba(0, 113, 227, 0.30); transition: transform 0.2s, opacity 0.2s; }
.save-press { transform: scale(0.97); opacity: 0.88; }
.save-dis { background: #C7C7CC; box-shadow: none; pointer-events: none; }
