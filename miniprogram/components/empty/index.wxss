.em { padding: 140rpx 60rpx 60rpx; display: flex; flex-direction: column; align-items: center; text-align: center; box-sizing: border-box; }
.em-ico { width: 168rpx; height: 168rpx; }
.em-t { margin-top: 24rpx; font-size: 36rpx; font-weight: 600; color: #1D1D1F; }
.em-d { margin-top: 12rpx; font-size: 28rpx; color: #6E6E73; line-height: 1.5; }
.em-btn { margin-top: 44rpx; height: 88rpx; padding: 0 64rpx; border-radius: 44rpx; background: #0071E3; color: #fff; font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(0, 113, 227, 0.28); box-sizing: border-box; }
.em-press { opacity: 0.85; transform: scale(0.97); }
