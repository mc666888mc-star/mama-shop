/* ==== 妈妈小店 · 全局设计变量与基础样式 ==== */
page {
  --bg: #F5F5F7;
  --ink: #1D1D1F;
  --ink2: #6E6E73;
  --ink3: #A1A1A6;
  --line: rgba(60, 60, 67, 0.14);
  --blue: #0071E3;
  --blue-soft: rgba(0, 113, 227, 0.10);
  --red: #FF3B30;
  --green: #34C759;
  --orange: #FF9500;
  background: #F5F5F7;
  color: #1D1D1F;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}
view, text, input, textarea, image, scroll-view, swiper { box-sizing: border-box; }
input, textarea { font-family: inherit; }

/* ---- 液态玻璃：只用在“浮层”（导航、底栏、弹层、悬浮按钮）上 ---- */
.glass {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 16rpx 56rpx rgba(0, 0, 0, 0.12), inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
}
@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .glass {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.54));
    -webkit-backdrop-filter: saturate(200%) blur(32px);
    backdrop-filter: saturate(200%) blur(32px);
  }
}

/* ---- 按压反馈 ---- */
.press { transform: scale(0.96); opacity: 0.86; }

/* ---- 按钮 ---- */
.btn {
  height: 96rpx; padding: 0 40rpx; border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600;
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s;
}
.btn-primary { background: #0071E3; color: #fff; box-shadow: 0 8rpx 24rpx rgba(0, 113, 227, 0.28); }
.btn-soft { background: rgba(0, 113, 227, 0.10); color: #0071E3; }
.btn-primary.disabled { background: #D2D2D7; color: #fff; box-shadow: none; pointer-events: none; }
.btn-soft.disabled { background: rgba(118, 118, 128, 0.12); color: #A1A1A6; pointer-events: none; }

/* ---- 通用 ---- */
.card { background: #fff; border-radius: 40rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.tab-safe { height: calc(230rpx + env(safe-area-inset-bottom)); }
.sk { background: rgba(60, 60, 67, 0.07); border-radius: 40rpx; }
