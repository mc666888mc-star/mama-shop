<view class="tb-wrap">
  <view class="tb-pill">
    <view wx:for="{{list}}" wx:key="path" class="tb-item {{selected === index ? 'tb-on' : ''}}" hover-class="tb-press" hover-stay-time="30" data-i="{{index}}" bindtap="go">
      <view class="tb-ico-wrap">
        <image class="tb-ico" src="/images/icons/{{item.icon}}{{selected === index ? '-on' : ''}}.svg" />
        <view wx:if="{{item.icon === 'cart' && cartCount > 0}}" class="tb-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
      </view>
      <view class="tb-txt">{{item.text}}</view>
    </view>
  </view>
</view>
